# ==============================================================================
# RAKSHAK AI - ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# Copy this file to '.env' and fill in your private api keys.
# DO NOT commit the '.env' file to your version control system.
# ==============================================================================

# Application Settings
EXPO_PUBLIC_APP_ENV=development # development, staging, production
EXPO_PUBLIC_API_URL=http://10.0.2.2:5000/api/v1 # 10.0.2.2 points to localhost from Android Emulator

# Future AI Integration Credentials
# (Required for direct client-side AI inference / testing)
EXPO_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
EXPO_PUBLIC_OPENAI_API_KEY=your_openai_api_key_here

# Security configuration (for client-side encryption keys in secure store)
EXPO_PUBLIC_SECURE_STORAGE_SALT=your_secure_storage_salt_here
